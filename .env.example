NOTION_API_KEY=
NOTION_RESEARCH_DATABASE_ID=
NOTION_TEACHING_DATABASE_ID=
NOTION_IDENTITY_DATABASE_ID=
NOTION_KNOWLEDGE_DATABASE_ID=
NOTION_KNOWLEDGE_DATA_SOURCE_ID=
NOTION_INSPIRATION_DATABASE_ID=
NOTION_BRAND_DATABASE_ID=
NOTION_ACTION_DATABASE_ID=
NOTION_MODULES_DATABASE_ID=
NOTION_COLLABORATION_DATABASE_ID=

AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_MVP_TABLE_ID=
AIRTABLE_PROJECTS_TABLE_ID=
AIRTABLE_COLLABORATION_TABLE_ID=
# Required in Production/Preview. Audit fails closed when absent; new audit rows never use Projects.
AIRTABLE_AUDIT_TABLE_ID=

# Optional dedicated HMAC secret for short-lived write confirmation tokens.
# Production falls back to the server-only Airtable key until this is configured.
NEXAEON_TOOL_EXECUTION_SECRET=

# Required for the restricted admin session and /admin/audit viewer.
NEXAEON_ADMIN_ACTOR_ID=
NEXAEON_ADMIN_ACCESS_SECRET=
# Use an independent high-entropy secret. Falls back server-side to the tool/Airtable secret only for migration.
NEXAEON_ADMIN_SESSION_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
NEXAEON_AGENT_ENABLED=false
NEXAEON_AGENT_FORCE_SOURCES_ONLY=false
NEXAEON_AGENT_MAX_OUTPUT_TOKENS=800
NEXAEON_AGENT_TIMEOUT_MS=25000
# Migration note: NEXON_AGENT_ENABLED is temporarily read by the server for backwards compatibility only.
